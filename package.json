{
  "name": "robot-game",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && node scripts/licenses.mjs && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test",
    "check": "npm run typecheck && npm test && npm run e2e",
    "trace": "node scripts/analyze-trace.mjs",
    "models": "node scripts/make-models.mjs",
    "e2e:prod": "E2E_PROD=1 playwright test",
    "licenses": "node scripts/licenses.mjs"
  },
  "dependencies": {
    "@babylonjs/core": "^9.36.0",
    "@babylonjs/gui": "^9.36.0",
    "@babylonjs/havok": "^1.3.14",
    "@babylonjs/loaders": "^9.36.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8",
    "vitest": "^5.1.0"
  }
}
